{
    "manifest_version": 3,
    "name": "conectome v0.0.1",
    "version": "1.0",
    "description": "Simple testing tool in the browser",
    "background": {
        "service_worker": "background.js"
    },
    "permissions": ["activeTab","tabs"],
    "action": {
        "default_icon": {
            "16": "0.png",
            "48": "0.png",
            "128": "0.png"
        }
    },
    "host_permissions": [
        "<all_urls>"
    ],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content_script.js"]
        }
    ]
}
